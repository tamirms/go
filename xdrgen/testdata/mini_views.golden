func (o OptionalMixedView) Unwrap() (MixedView, bool, error) {
	var zero MixedView
	if len(o) < 4 {
		return zero, false, viewErrShortBuffer(0, "need 4 bytes for optional flag")
	}
	flag := binary.BigEndian.Uint32(o[:4])
	switch flag {
	case 0:
		return zero, false, nil
	case 1:
		return MixedView(o[4:]), true, nil
	default:
		return zero, false, viewErrBadBoolValue(0, flag)
	}
}
