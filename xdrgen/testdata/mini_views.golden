type PairsView []byte

func (v PairsView) Count() (int, error) { return arrayViewCountChecked([]byte(v), 10, 12) }
func (v PairsView) size(depth int) (int, error) {
	if depth > maxDepth {
		return 0, viewErrMaxDepth(0)
	}
	count, err := arrayViewCount([]byte(v), 10)
	if err != nil {
		return 0, err
	}
	total := int64(4) + int64(count)*int64(12)
	if total > int64(len(v)) {
		return 0, viewErrArrayCountExceedsData(4, count, len(v)-4)
	}
	return int(total), nil
}
func (v PairsView) valid(depth int) (int, error) {
	if depth > maxDepth {
		return 0, viewErrMaxDepth(0)
	}
	count, err := arrayViewCount([]byte(v), 10)
	if err != nil {
		return 0, err
	}
	return arrayTraverse([]byte(v), count, 4, func(d []byte) (int, error) { return PairView(d).valid(depth + 1) })
}
func (v PairsView) At(i int) (PairView, error) {
	var zero PairView
	count, err := arrayViewCount([]byte(v), 10)
	if err != nil {
		return zero, err
	}
	if i < 0 || i >= count {
		return zero, viewErrIndexOutOfRange(0, i, count)
	}
	off64 := int64(4) + int64(i)*int64(12)
	if off64+int64(12) > int64(len(v)) {
		return zero, viewErrShortBuffer(uint32(off64), "need 12 bytes")
	}
	return PairView(v[int(off64):]), nil
}

// PairsViewCursor is the Scan() cursor over PairsView. It is returned by value: plain loops allocate nothing.
type PairsViewCursor struct {
	buf   []byte
	off   int
	count int
	index int
	elem  PairFields
	valid bool
	err   error
}

// Scan returns a by-value cursor over the array's elements. The wire count is validated against the buffer at construction.
func (v PairsView) Scan() PairsViewCursor {
	count, err := arrayViewCountChecked([]byte(v), 10, 12)
	return PairsViewCursor{buf: []byte(v), off: 4, count: count, index: -1, err: err}
}

// Next advances to the next element, walking it once and capturing what Elem()/Bytes() need. Returns false at end or on error.
func (c *PairsViewCursor) Next() bool {
	c.valid = false
	if c.err != nil || c.index+1 >= c.count {
		return false
	}
	if uint(c.off) > uint(len(c.buf)) {
		c.err = viewErrShortBuffer(uint32(c.off), "element offset exceeds data")
		return false
	}
	fields, err := locatePair(PairView(c.buf[c.off:]))
	if err != nil {
		c.err = err
		return false
	}
	c.elem = fields
	c.off += len(fields.View)
	c.index++
	c.valid = true
	return true
}

// Count returns the validated element count, safe for preallocation.
func (c *PairsViewCursor) Count() int { return c.count }

// Index returns the 0-based position of the current element, or -1 before the first Next().
func (c *PairsViewCursor) Index() int { return c.index }

// Elem returns the current element. Before the first Next(), after Next() returns false,
// or after an error, it returns the zero value and arms a sticky misuse error.
func (c *PairsViewCursor) Elem() PairFields {
	if !c.valid {
		c.armMisuse()
		var zero PairFields
		return zero
	}
	return c.elem
}

// Bytes returns the current element's exact wire bytes (captured during Next, zero cost). Same misuse contract as Elem().
func (c *PairsViewCursor) Bytes() []byte {
	if !c.valid {
		c.armMisuse()
		return nil
	}
	return []byte(c.elem.View)
}

// Err returns the first error encountered, if any.
func (c *PairsViewCursor) Err() error { return c.err }
func (c *PairsViewCursor) armMisuse() {
	if c.err == nil {
		c.err = errCursorMisuse
	}
}

